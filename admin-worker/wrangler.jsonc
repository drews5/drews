{
  "name": "rewrite-admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "SITE_ORIGIN": "https://drews.click" },
  "durable_objects": { "bindings": [{ "name": "ADMIN_SERVICE", "class_name": "AdminService" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdminService"] }]
}
